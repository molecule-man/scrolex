<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<template class="MyApp" parent="GtkApplicationWindow">
		<property name="title">Scrolex PDF Viewer</property>
		<property name="default-width">1280</property>
		<property name="default-height">800</property>
		<child type="titlebar">
			<object class="GtkHeaderBar" id="headerbar">
				<child type="title">
					<object class="GtkBox">
						<property name="orientation">horizontal</property>
						<property name="spacing">6</property>
						<child>
							<object class="GtkButton" id="btn_jump_back">
								<signal name="clicked" handler="jump_back" swapped="true"/>
								<property name="icon-name">go-previous</property>
								<property name="cursor">
									<object class="GdkCursor">
										<property name="name">pointer</property>
									</object>
								</property>
								<binding name="sensitive">
									<closure type="gboolean" function="can_jump_back">
										<lookup name="prev_page"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
									</closure>
								</binding>
								<binding name="tooltip-text">
									<closure type="gchararray" function="back_btn_text">
										<lookup name="prev_page"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
									</closure>
								</binding>
							</object>
						</child>
						<child>
							<object class="GtkButton" id="btn_jump_forward">
								<signal name="clicked" handler="jump_forward" swapped="true"/>
								<property name="icon-name">go-next</property>
								<property name="cursor">
									<object class="GdkCursor">
										<property name="name">pointer</property>
									</object>
								</property>
								<binding name="sensitive">
									<closure type="gboolean" function="can_jump_forward">
										<lookup name="next_page"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
									</closure>
								</binding>
								<binding name="tooltip-text">
									<closure type="gchararray" function="forward_btn_text">
										<lookup name="next_page"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
									</closure>
								</binding>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Page:</property>
							</object>
						</child>
						<child>
							<object class="GtkEntry" id="entry_page_num">
								<signal name="activate" handler="handle_page_number_entered" swapped="true"/>
								<signal name="icon-press" handler="handle_page_number_icon_pressed" swapped="true"/>
								<property name="secondary-icon-name">object-select-symbolic</property>
								<property name="secondary-icon-tooltip-text">Go to the page number you typed (Enter)</property>
								<property name="halign">end</property>
								<property name="valign">baseline-center</property>
								<property name="width-chars">4</property>
								<property name="max-width-chars">4</property>
								<property name="input-purpose">digits</property>
								<binding name="text">
									<closure type="gchararray" function="page_entry_text">
										<lookup name="page_number" type="PageNumber">
											<lookup name="selected-item"><lookup name="selection" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
										</lookup>
									</closure>
								</binding>
								<binding name="secondary-icon-sensitive">
									<closure type="gboolean" function="page_jump_enabled">
										<lookup name="text">entry_page_num</lookup>
										<lookup name="page"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
									</closure>
								</binding>
							</object>
						</child>
					</object>
					<!--<object class="GtkLabel" id="title">-->
					<!--	<property name="label">Scrolex</property>-->
					<!--</object>-->
				</child>				<child type="start">
					<object class="GtkButton" id="btn_open">
						<signal name="clicked" handler="open_document" swapped="true"/>
						<property name="icon-name">document-open</property>
						<property name="tooltip-text">Open PDF Document</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="start">
					<object class="GtkButton" id="btn_new_tab">
						<signal name="clicked" handler="new_tab" swapped="true"/>
						<property name="icon-name">tab-new-symbolic</property>
						<property name="tooltip-text">Open a document in a new tab (Ctrl+T)</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="start">
					<object class="GtkToggleButton" id="btn_toc">
						<property name="icon-name">view-list-symbolic</property>
						<property name="tooltip-text">Contents (t)</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="end">
					<object class="GtkMenuButton" id="btn_menu">
						<property name="icon-name">open-menu-symbolic</property>
						<property name="tooltip-text">Settings</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
						<property name="popover">
							<object class="GtkPopover">
								<property name="child">
									<object class="GtkBox">
										<property name="orientation">vertical</property>
										<property name="spacing">12</property>
										<property name="margin-top">8</property>
										<property name="margin-bottom">8</property>
										<property name="margin-start">8</property>
										<property name="margin-end">8</property>
										<child>
											<object class="GtkButton" id="btn_menu_search">
												<signal name="clicked" handler="menu_search" swapped="true"/>
												<property name="label">Find in document</property>
												<property name="tooltip-text">Search (f or Ctrl+F)</property>
											</object>
										</child>
										<child>
											<object class="GtkToggleButton" id="btn_dark_mode">
												<property name="action-name">app.dark-mode</property>
												<property name="label">Dark Mode</property>
												<property name="tooltip-text">Recolor document pages for a dark background</property>
											</object>
										</child>
										<child>
											<object class="GtkToggleButton" id="btn_animate_scroll">
												<property name="label">Animate Scroll</property>
												<property name="tooltip-text">Slide by one page on scroll instead of jumping</property>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="orientation">horizontal</property>
												<property name="spacing">8</property>
												<child>
													<object class="GtkLabel">
														<property name="label">Render threads</property>
														<property name="halign">start</property>
														<property name="hexpand">true</property>
													</object>
												</child>
												<child>
													<object class="GtkSpinButton" id="spin_threads">
														<property name="numeric">true</property>
														<property name="tooltip-text">Background page-render threads</property>
														<property name="adjustment">
															<object class="GtkAdjustment">
																<property name="lower">1</property>
																<property name="upper">64</property>
																<property name="step-increment">1</property>
																<property name="page-increment">1</property>
															</object>
														</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">More threads render faster but use more memory.</property>
												<property name="wrap">true</property>
												<property name="max-width-chars">28</property>
												<property name="xalign">0</property>
												<style>
													<class name="dim-label"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkBox">
												<property name="orientation">horizontal</property>
												<property name="spacing">8</property>
												<child>
													<object class="GtkLabel">
														<property name="label">Total render cache (MB)</property>
														<property name="halign">start</property>
														<property name="hexpand">true</property>
													</object>
												</child>
												<child>
													<object class="GtkSpinButton" id="spin_cache">
														<property name="numeric">true</property>
														<property name="tooltip-text">Memory budget for cached rendered pages, shared by every open document</property>
														<property name="adjustment">
															<object class="GtkAdjustment">
																<property name="lower">32</property>
																<property name="upper">512</property>
																<property name="step-increment">32</property>
																<property name="page-increment">64</property>
															</object>
														</property>
													</object>
												</child>
											</object>
										</child>
										<child>
											<object class="GtkLabel">
												<property name="label">A larger cache keeps more rendered pages in memory. Open documents share it.</property>
												<property name="wrap">true</property>
												<property name="max-width-chars">28</property>
												<property name="xalign">0</property>
												<style>
													<class name="dim-label"/>
												</style>
											</object>
										</child>
										<child>
											<object class="GtkSeparator"/>
										</child>
										<child>
											<object class="GtkButton" id="btn_menu_about">
												<signal name="clicked" handler="menu_about" swapped="true"/>
												<property name="label">About Scrolex</property>
												<property name="tooltip-text">Version info and issue tracker</property>
											</object>
										</child>
									</object>
								</property>
							</object>
						</property>
					</object>
				</child>				<child type="end">
					<object class="GtkToggleButton" id="btn_crop">
						<property name="label">Crop Margins</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="end">
					<object class="GtkToggleButton" id="btn_fit_height">
						<property name="icon-name">zoom-fit-best-symbolic</property>
						<property name="tooltip-text">Fit document to the window height</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="end">
					<object class="GtkButton" id="btn_zoom_in">
						<signal name="clicked" handler="zoom_in" swapped="true"/>
						<property name="icon-name">zoom-in</property>
						<property name="tooltip-text">Zoom in</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>				<child type="end">
					<object class="GtkEntry" id="entry_zoom">
						<signal name="activate" handler="handle_zoom_entry" swapped="true"/>
						<signal name="icon-press" handler="handle_zoom_entry_icon" swapped="true"/>
						<property name="secondary-icon-name">object-select-symbolic</property>
						<property name="secondary-icon-tooltip-text">Apply the zoom level you typed (Enter)</property>
						<property name="halign">end</property>
						<property name="valign">baseline-center</property>
						<property name="width-chars">6</property>
						<property name="max-width-chars">6</property>
						<property name="input-purpose">digits</property>
						<binding name="text">
							<closure type="gchararray" function="zoom_entry_text">
								<lookup name="zoom"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
							</closure>
						</binding>
						<binding name="secondary-icon-sensitive">
							<closure type="gboolean" function="zoom_apply_enabled">
								<lookup name="text">entry_zoom</lookup>
								<lookup name="zoom"><lookup name="state" type="DocumentView"><lookup name="active-document">MyApp</lookup></lookup></lookup>
							</closure>
						</binding>
					</object>
				</child>				<child type="end">
					<object class="GtkButton" id="btn_zoom_out">
						<signal name="clicked" handler="zoom_out" swapped="true"/>
						<property name="icon-name">zoom-out</property>
						<property name="tooltip-text">Zoom Out</property>
						<property name="cursor">
							<object class="GdkCursor">
								<property name="name">pointer</property>
							</object>
						</property>
					</object>
				</child>
			</object>
		</child>
		<child>
			<object class="GtkNotebook" id="notebook">
				<property name="vexpand">true</property>
				<property name="show-tabs">false</property>
				<property name="show-border">false</property>
				<property name="scrollable">true</property>
			</object>
		</child>
	</template>
</interface>
