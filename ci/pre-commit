#!/usr/bin/env bash
# The lint gate of ci.yml, run before every commit. Install it with:
#   ln -sf ../../ci/pre-commit .git/hooks/pre-commit
# It checks the working tree, not the index. Skip it once with `git commit --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: cargo fmt"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy"
cargo clippy --all-targets -- -D warnings
