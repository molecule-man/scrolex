#!/bin/sh
set -eu

usage() {
	cat >&2 <<'EOF'
usage: ci/bump-version <version> [date]

  version  MAJOR.MINOR.PATCH, optionally with a pre-release suffix (0.8.0-rc1)
  date     release date for the metainfo entry, YYYY-MM-DD (default: today)
EOF
	exit 2
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
version=$1
date=${2:-$(date +%F)}

if ! printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'; then
	echo "bump-version: '$version' is not a valid version" >&2
	exit 1
fi
if [ "$(date -d "$date" +%F 2>/dev/null)" != "$date" ]; then
	echo "bump-version: '$date' is not a valid YYYY-MM-DD date" >&2
	exit 1
fi

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

metainfo=resources/com.andr2i.scrolex.metainfo.xml
sources=packaging/flatpak/cargo-sources.json
generator=https://raw.githubusercontent.com/flatpak/flatpak-builder-tools/f03a673abe6ce189cea1c2857e2b44af2dd79d1f/cargo/flatpak-cargo-generator.py
for f in Cargo.toml Cargo.lock "$metainfo" "$sources"; do
	[ -f "$f" ] || { echo "bump-version: $f not found" >&2; exit 1; }
done

previous=$(sed -n 's/^version *= *"\(.*\)"/\1/p' Cargo.toml | head -1)
repository=$(sed -n 's/^repository *= *"\(.*\)"/\1/p' Cargo.toml | head -1)
[ -n "$repository" ] || { echo "bump-version: no repository in Cargo.toml" >&2; exit 1; }

awk -v v="$version" '
	/^\[/ { in_package = ($0 == "[package]") }
	in_package && /^version *=/ && !seen { print "version = \"" v "\""; seen = 1; next }
	{ print }
' Cargo.toml > Cargo.toml.bump && mv Cargo.toml.bump Cargo.toml

awk -v v="$version" '
	after_name && /^version *=/ { print "version = \"" v "\""; after_name = 0; next }
	{ after_name = ($0 == "name = \"scrolex\""); print }
' Cargo.lock > Cargo.lock.bump && mv Cargo.lock.bump Cargo.lock

# GitHub puts the PR title in the body of the merge commit
merge_titles() {
	git log --merges --reverse --format=%H "$1..HEAD" | while read -r sha; do
		title=$(git log -1 --format=%b "$sha" | sed '/^[[:space:]]*$/d' | head -1)
		[ -n "$title" ] || title=$(git log -1 --format=%s "$sha")
		printf '%s' "$title" |
			grep -Eq '^(chore|ci|docs|test|refactor|style|build)(\([^)]*\))?!?:' && continue
		printf '%s\n' "$title" |
			sed -E 's/^(feat|fix|perf|revert)(\([^)]*\))?!?: *//' |
			sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' |
			awk '{ printf "          <li>%s%s</li>\n", toupper(substr($0, 1, 1)), substr($0, 2) }'
	done
}

release_notes() {
	notes=
	notes_note="no release notes"

	last=$(sed -n 's/.*<release version="\([^"]*\)".*/\1/p' "$metainfo" | head -1)
	if [ -z "$last" ]; then
		notes_note="no release notes: $metainfo lists none to compare against"
		return 0
	fi
	if ! git rev-parse -q --verify "refs/tags/$last" >/dev/null 2>&1; then
		notes_note="no release notes: tag $last not found, write them by hand"
		return 0
	fi

	items=$(merge_titles "$last")
	if [ -z "$items" ]; then
		notes_note="no release notes: no PR merges since $last"
		return 0
	fi

	notes="      <description>
        <ul>
$items
        </ul>
      </description>"
	notes_note="release notes: $(printf '%s\n' "$items" | wc -l | tr -d ' ') from PR merges since $last"
}

# AppStream sorts 0.7.3-rc1 above 0.7.3, so listing a pre-release breaks the
# ordering once the final release lands
case $version in
*-*)
	metainfo_note="pre-release, not listed"
	;;
*)
	if grep -q "<release version=\"$version\"" "$metainfo"; then
		metainfo_note="already listed $version, left alone"
	else
		release_notes
		awk -v v="$version" -v d="$date" -v url="$repository" -v notes="$notes" '
			{ print }
			/<releases>/ && !seen {
				printf "    <release version=\"%s\" date=\"%s\">\n", v, d
				printf "      <url>%s/releases/tag/%s</url>\n", url, v
				if (notes != "") print notes
				print  "    </release>"
				seen = 1
			}
		' "$metainfo" > "$metainfo.bump" && mv "$metainfo.bump" "$metainfo"
		metainfo_note="added $version dated $date, $notes_note"
	fi
	;;
esac

command -v uv >/dev/null || {
	echo "bump-version: uv is required to regenerate $sources" >&2
	exit 1
}
uv run --quiet "$generator" Cargo.lock -o "$sources" || {
	echo "bump-version: failed to regenerate $sources" >&2
	exit 1
}
ci/check-cargo-sources >/dev/null

echo "$previous -> $version"
echo "  Cargo.toml"
echo "  Cargo.lock"
echo "  $metainfo ($metainfo_note)"
echo "  $sources (regenerated)"
