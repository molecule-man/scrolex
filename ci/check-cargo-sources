#!/usr/bin/env python3
"""Fails if packaging/flatpak/cargo-sources.json has drifted from Cargo.lock."""
import json
import re
import sys

LOCK = "Cargo.lock"
SOURCES = "packaging/flatpak/cargo-sources.json"
REGEN = "ci/bump-version regenerates this; to do it by hand see packaging/flatpak/README.md"


def from_lock():
    crates = {}
    for block in open(LOCK).read().split("[[package]]")[1:]:
        checksum = re.search(r'^checksum = "([^"]+)"', block, re.M)
        if not checksum:
            continue  # the root crate is not vendored
        name = re.search(r'^name = "([^"]+)"', block, re.M).group(1)
        version = re.search(r'^version = "([^"]+)"', block, re.M).group(1)
        crates[(name, version)] = checksum.group(1)
    return crates


def from_sources():
    srcs = json.load(open(SOURCES))
    crates, checksum_files = {}, {}
    for s in srcs:
        if s.get("type") == "archive":
            segments = s["url"].split("/")
            name, filename = segments[-2], segments[-1]
            version = filename[len(name) + 1 : -len(".crate")]
            crates[(name, version)] = s["sha256"]
        elif s.get("dest-filename") == ".cargo-checksum.json":
            checksum_files[s["dest"]] = json.loads(s["contents"]).get("package")
    return crates, checksum_files


lock = from_lock()
sources, checksum_files = from_sources()
problems = []

for missing in sorted(set(lock) - set(sources)):
    problems.append(f"missing from {SOURCES}: {missing[0]} {missing[1]}")
for extra in sorted(set(sources) - set(lock)):
    problems.append(f"not in {LOCK}: {extra[0]} {extra[1]}")
for key in sorted(set(lock) & set(sources)):
    if lock[key] != sources[key]:
        problems.append(f"checksum differs for {key[0]} {key[1]}")
for (name, version), sha in sorted(sources.items()):
    dest = f"cargo/vendor/{name}-{version}"
    if checksum_files.get(dest) != sha:
        problems.append(f"bad .cargo-checksum.json for {name} {version}")

if problems:
    for p in problems:
        print(f"check-cargo-sources: {p}", file=sys.stderr)
    print(f"\n{REGEN}", file=sys.stderr)
    sys.exit(1)

print(f"cargo-sources.json is in sync with {LOCK} ({len(lock)} crates)")
